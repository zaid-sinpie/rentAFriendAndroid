# ==============================================================================
# React Native / Node / Android / iOS .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------------------------------------------
# Environment Variables & Sensitive Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p12
*.p8
*.keystore
!android/app/debug.keystore
!debug.keystore
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# React Native & Metro Bundler
# ------------------------------------------------------------------------------
.metro-health-check*
.metro-cache/
.expo/
*.bundle
*.bundle.map
*.bundle.meta
metro.config.local.js
report.*.json
report.*.html
package-list.json

# Generated bundle files inside Android/iOS assets
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map
android/app/src/main/assets/index.android.bundle.meta
android/app/src/main/res/drawable-*/
android/app/src/main/res/raw/
ios/main.jsbundle
ios/main.jsbundle.map

# ------------------------------------------------------------------------------
# Android (Build Artifacts, Caches & Binaries)
# ------------------------------------------------------------------------------
.gradle/
android/.gradle/
android/.kotlin/
.kotlin/
build/
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
.cxx/
android/local.properties
local.properties
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hprof

# ------------------------------------------------------------------------------
# iOS & Xcode
# ------------------------------------------------------------------------------
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
.xcode.env.local
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.dSYM.zip
*.dSYM

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# OS Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Testing, Coverage & TypeScript
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Temporary & Cache Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.log
